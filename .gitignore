.DS_Store

# Single source of truth: the website is committed at the repo root (served by
# GitHub Pages). The iOS app's copy is generated from it via ./sync-www.sh and
# is NOT tracked — run the script before building/committing the app.
StandardWorks/www/

# Local Claude Code config (not shared)
.claude/

# Xcode project state — never goes to GitHub (translator's standing rule).
StandardWorks.xcodeproj/project.pbxproj
StandardWorks.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# Never commit the KDP print interior (standing rule)
*KDP 6x9.docx
