.DS_Store

# Single source of truth: the website is committed at the repo root (served by
# GitHub Pages). The iOS app's copy is generated from it via ./sync-www.sh and
# is NOT tracked — run the script before building/committing the app.
StandardWorks/www/

# Local Claude Code config (not shared)
.claude/

# Xcode project state — never goes to GitHub (translator's standing rule).
StandardWorks.xcodeproj/project.pbxproj
StandardWorks.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# Never commit the KDP print interior (standing rule).
# Broadened 2026-08-31: the narrow "*KDP 6x9.docx" rule did not cover the
# Hebrew BOM/ manuscripts, and five of them reached GitHub before anyone
# noticed. They were purged from all history with git-filter-repo. No .docx
# in this project belongs on the remote, so the rule is now the whole type.
*.docx

# Institute of Ancient Studies material — copyrighted, comparison only.
# User ruling 2026-08-31: this NEVER ships. Kept at ~/Desktop/IAS-reference-NEVER-SHIP/
ias_full.txt
ias_*.txt
*Hebrew-Book-of-Mormon-Translation*
IAS-reference*/

# TAHOT source data (STEPBible.org, CC BY 4.0). The licence permits reformatting
# for our own use but asks that the raw files not be redistributed — download
# them from github.com/STEPBible/STEPBible-Data and point
# tools/morphology/build_tahot_index.js at the folder.
tahot_*.txt
tahot_index.json
