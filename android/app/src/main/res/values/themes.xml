<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Navy window, no action bar: Compose draws everything, the bands
         behind the system bars included (ShellRoot), so the bars themselves
         are clear and the page's paper or the navy shows through them.
         EDGE TO EDGE WITHOUT enableEdgeToEdge (MainActivity): its bar colours
         are set here, in the theme, not by Window.setStatusBarColor and the
         cutout constants, which Android 15 deprecates and Play reports. A
         theme attribute is not an API call; Android 15 ignores these and draws
         the bars clear on its own. -->
    <style name="Theme.SeferMormon" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/system_nav_bar</item>
    </style>

    <!-- A SHEET RISES FROM THE BOTTOM EDGE AND FALLS BACK TO IT, as on the
         iPhone: the site-page sheet (SitePageSheet in SettingsView.kt). -->
    <style name="SheetAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_rise</item>
        <item name="android:windowExitAnimation">@anim/sheet_fall</item>
    </style>

    <!-- THE LOGO BEFORE ANYTHING: the system splash (the mark on navy) until
         the Activity is up, then LaunchSplash in Compose holds the same logo
         on the same navy until the first page has loaded — the way the
         iPhone app opens. -->
    <style name="Theme.SeferMormon.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.SeferMormon</item>
    </style>
</resources>
