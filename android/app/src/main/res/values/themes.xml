<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Navy window, no action bar: Compose draws everything. -->
    <style name="Theme.SeferMormon" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- THE LOGO BEFORE ANYTHING: the system splash (the mark on navy) until
         the Activity is up, then LaunchSplash in Compose holds the same logo
         on the same navy until the first page has loaded — the way the
         iPhone app opens. -->
    <style name="Theme.SeferMormon.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.SeferMormon</item>
    </style>
</resources>
