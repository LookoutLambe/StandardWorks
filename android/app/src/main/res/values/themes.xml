<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SeferMormon" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
    </style>

    <!-- Shown by the window manager before any of our code runs, so the app
         never opens on a blank white page. -->
    <style name="Theme.SeferMormon.Splash" parent="Theme.SeferMormon">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
