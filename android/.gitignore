# The Android project is real source now (a WebView app, not a generated TWA
# shell), so app/ is tracked. Only build output and secrets stay out.
.gradle/
build/
app/build/
local.properties
node_modules/
package-lock.json
*.log

# THE UPLOAD KEY NEVER GOES IN A PUBLIC REPO.
# It lives at ~/sefermormon-release.keystore (alias: sefermormon) and is the
# only thing that lets you ship an update to the existing Play listing.
*.keystore
*.jks

# Build outputs.
*.aab
*.apk
*.idsig
